# Partner Visa CRM — environment variables
#
# Copy to `.env.local` for local development and fill in real values.
# `.env.local` is gitignored; never commit real keys.
#
# In production these are set in the Vercel dashboard for all three
# environments: Production, Preview and Development.

# ---------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser)
# ---------------------------------------------------------------------------

# Project URL. Supabase dashboard → Project Settings → Data API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key. Safe in the browser: it carries no privileges of its
# own and every request it makes is constrained by Row Level Security.
# Supabase dashboard → Project Settings → API Keys → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server-only secrets — never prefix these with NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# Service role key. BYPASSES Row Level Security entirely — it can read and
# write every user's data. Server-side only, and only where a user-scoped
# client genuinely cannot do the job (seeding, account deletion).
# Supabase dashboard → Project Settings → API Keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key, used by the document review, readiness analysis,
# statement drafter and Q&A routes. Server-side only.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical origin, used to build Supabase Auth redirect URLs (email
# confirmation, password reset). No trailing slash.
# Local: http://localhost:3000
# Production: https://your-domain.com
#
# Whatever you set here must also be added in the Supabase dashboard under
# Authentication → URL Configuration (Site URL + redirect allow-list), or
# auth callbacks will be rejected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
